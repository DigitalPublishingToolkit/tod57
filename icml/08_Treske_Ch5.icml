						<Link Self="u3eee" AssetURL="$ID/" AssetID="$ID/" LinkResourceURI="file:imgs/Treske_Image5.png" LinkResourceFormat="$ID/" StoredState="Normal" LinkClassID="35906" LinkClientID="257" LinkResourceModified="true" LinkObjectModified="false" ShowInUI="true" CanEmbed="true" CanUnembed="true" CanPackage="true" ImportPolicy="NoAutoImport" ExportPolicy="NoAutoExport" LinkResourceSize="0~0" RenditionData="Actual" />
					</Image>
