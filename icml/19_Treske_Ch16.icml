  </CharacterStyleRange>
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content> Fig. 15. UNKNOWN CLOSER</Content>
  </CharacterStyleRange>
</ParagraphStyleRange>

  </Story>
  
